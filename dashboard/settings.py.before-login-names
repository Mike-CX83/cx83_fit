# Optional dedicated personal issuer inside this application. Existing external
# JWT mode stays the default and no endpoint is activated by installing the library.
HEALTH_OAUTH_ENABLED = os.getenv('MCP_AUTH_MODE', 'external') == 'builtin'
HEALTH_OAUTH_ORIGIN = os.getenv('MCP_PUBLIC_ORIGIN', '').rstrip('/')
HEALTH_OAUTH_RESOURCE = HEALTH_OAUTH_ORIGIN + '/mcp'
HEALTH_OAUTH_WRITES = os.getenv('MCP_WRITES_ENABLED', '0') == '1'
if HEALTH_OAUTH_ENABLED:
    from urllib.parse import urlsplit
    origin = urlsplit(HEALTH_OAUTH_ORIGIN)
    local_origin = LOCAL_ONLY and origin.scheme == 'http' and origin.hostname in {'localhost', '127.0.0.1', '::1'}
    if (not origin.hostname or origin.username or origin.password or origin.path or origin.query or origin.fragment
            or (origin.scheme != 'https' and not local_origin)):
        raise ImproperlyConfigured('MCP_PUBLIC_ORIGIN must be an HTTPS origin, or explicit local loopback HTTP.')
    if LOCAL_ONLY and origin.hostname not in {'localhost', '127.0.0.1', '::1'}:
        raise ImproperlyConfigured('Local mode cannot advertise a public OAuth origin.')
    if any(os.getenv(name) for name in ('MCP_ISSUER_URL', 'MCP_JWKS_URL', 'MCP_RESOURCE_URL', 'MCP_SUBJECT')):
        raise ImproperlyConfigured('Choose built in or external MCP authentication, not both.')
    if os.getenv('MCP_WRITES_ENABLED', '0') not in {'0', '1'}:
        raise ImproperlyConfigured('MCP_WRITES_ENABLED must be 0 or 1.')

